# Used by `npm run dev` and Docker (`npm run docker:up`). Copy to backend/.env.
DATABASE_URL="file:./dev.db"
PORT=3001
# nominatim | google | mock
PHARMACY_SEARCH_PROVIDER=nominatim
# Required when PHARMACY_SEARCH_PROVIDER=google (Places API New + Geocoding API)
# GOOGLE_PLACES_API_KEY=

# ── Voice agent ────────────────────────────────────────────────────────────────
# Set VOICE_PROVIDER to choose which backend places the outbound calls.
# Default is "vapi" if unset.
# VOICE_PROVIDER=twilio   # twilio | vapi

# ── Twilio + Gemini Live (VOICE_PROVIDER=twilio) ─────────────────────────────
# Twilio account credentials — https://console.twilio.com
# TWILIO_ACCOUNT_SID=ACxxxxx
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx   # outbound caller ID (E.164)
# GEMINI_API_KEY=                    # Gemini Developer API key (or use GOOGLE_API_KEY)
# Optional: override default live model (native audio), e.g. preview builds from Google AI docs
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# PUBLIC_API_URL=http://localhost:3001  # must be reachable by Twilio (use ngrok in dev)
#   In dev, tunnel to port 3001: ngrok http 3001
#   Twilio will POST to https://<tunnel>/api/webhooks/twilio/twiml
#   and open a WebSocket to wss://<tunnel>/api/ws/twilio

# ── Vapi (VOICE_PROVIDER=vapi, legacy) ────────────────────────────────────────
# https://dashboard.vapi.ai
# VAPI_API_KEY=
# VAPI_PHONE_NUMBER_ID=          # outbound caller ID from Vapi
# VAPI_ASSISTANT_ID=             # optional; uses built-in assistant if omitted
# PUBLIC_API_URL=http://localhost:3001   # must be reachable by Vapi (use ngrok in dev)
# VAPI_WEBHOOK_SECRET=           # optional; set same value in Vapi server URL secret
